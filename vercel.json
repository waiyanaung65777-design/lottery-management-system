{
  "version": 2,
  "redirects": [
    {
      "source": "/",
      "destination": "/login",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/banker",
      "destination": "/banker.html"
    },
    {
      "source": "/agent",
      "destination": "/agent.html"
    }
  ]
}
